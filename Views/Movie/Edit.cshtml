@model MovieMvc.Models.Movies

@{
    ViewBag.Title = "Edit";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tempusdominus-bootstrap-4/5.39.0/css/tempusdominus-bootstrap-4.min.css" />
}

<h2 class="my-4">แก้ไขข้อมูลภาพยนตร์</h2>

<div class="card shadow-sm">
    <div class="card-body">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @using (Html.BeginForm("Edit", "Movie", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(m => m.Id)

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Title, "ชื่อภาพยนตร์")
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "กรอกชื่อภาพยนตร์" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.ReleaseDate, "เข้าฉายเมื่อ")
                    <div class="input-group date" id="dtReleaseDate" data-target-input="nearest">
                        @Html.TextBoxFor(m => m.ReleaseDate, new {
                            @class = "form-control datetimepicker-input",
                            data_target = "#dtReleaseDate",
                            placeholder = "เลือกวันที่เข้าฉาย"
                        })
                        <div class="input-group-append" data-target="#dtReleaseDate" data-toggle="datetimepicker">
                            <div class="input-group-text">
                                <i class="fa fa-calendar"></i>
                            </div>
                        </div>
                    </div>
                    @Html.ValidationMessageFor(m => m.ReleaseDate, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Genre, "หมวดหมู่")
                    @Html.DropDownListFor(m => m.Genre, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Action", Value = "Action" },
                        new SelectListItem { Text = "Drama", Value = "Drama" },
                        new SelectListItem { Text = "Adventure", Value = "Adventure" },
                        new SelectListItem { Text = "Family", Value = "Family" },
                        new SelectListItem { Text = "Fantasy", Value = "Fantasy" }
                    }, "กรุณาเลือก", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Genre, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Duration, "ความยาว (นาที)")
                    @Html.TextBoxFor(m => m.Duration, new { @class = "form-control", placeholder = "กรอกความยาว (นาที)", type = "number" })
                    @Html.ValidationMessageFor(m => m.Duration, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-12 mb-3">
                    @Html.Label("fileCoverImg", "อัปโหลดรูปใหม่ (ถ้ามี)")
                    <input type="file" id="fileUpload" name="fileUpload" class="form-control" accept="image/*" />
                    <span class="text-danger" id="fileUploadError"></span>

                    @if (!string.IsNullOrEmpty(Model.CoverImg))
                    {
                        <div class="mt-3">
                            <label>รูปปัจจุบัน:</label><br />
                            <img src="@Model.CoverImg" alt="Current Cover" width="100" height="140" style="object-fit: cover;" />
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary mt-3">
                    <i class="fas fa-save"></i> อัปเดต
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tempusdominus-bootstrap-4/5.39.0/js/tempusdominus-bootstrap-4.min.js"></script>

    <script type="text/javascript">
        $(function () {
            $('#dtReleaseDate').datetimepicker({
                format: 'L',
                locale: 'en'
            });
        });
    </script>
}
