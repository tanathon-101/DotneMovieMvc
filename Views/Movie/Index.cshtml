@model IEnumerable<MovieMvc.Models.Movies>

@{
    ViewData["Title"] = "Movie List";
}

<h2 class="my-4">รายการภาพยนตร์</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="mb-3 text-end">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus"></i> เพิ่มภาพยนตร์ใหม่
            </a>
        </div>

        <table class="table table-striped table-bordered table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>#</th>
                    <th>ชื่อภาพยนตร์</th>
                    <th>วันที่เข้าฉาย</th>
                    <th>หมวดหมู่</th>
                    <th>ความยาว (นาที)</th>
                    <th>รูปภาพ</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var index = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td>@item.Title</td>
                            <td>@item.ReleaseDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.Genre</td>
                            <td>@item.Duration</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CoverImg))
                                {
                                    <img src="@item.CoverImg" alt="cover" width="80" height="100" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('คุณแน่ใจว่าต้องการลบ?');" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger ms-1">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">ไม่มีข้อมูลภาพยนตร์</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
